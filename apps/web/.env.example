# Driver web portal (apps/web) — copy to .env.local and fill in.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEV_DRIVER_ID=00000000-0000-0000-0000-000000000001

# Clerk — MUST be the DRIVER instance, the same one apps/driver uses
# (EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY). Note the NEXT_PUBLIC_ prefix: Next.js only
# exposes NEXT_PUBLIC_* to the browser, so an EXPO_-prefixed copy is invisible here.
# No secret key: CLERK_SECRET_KEY stays backend-only (CLERK_DRIVER_SECRET_KEY).
# middleware.ts derives the Frontend API host from this key and verifies session
# JWTs against the instance's public JWKS.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Optional: override the derived Frontend API host (custom Clerk domain).
# NEXT_PUBLIC_CLERK_FRONTEND_API=clerk.yourdomain.com

# Set to 'true' only for local work without Clerk: sends X-Teeko-User instead of
# a bearer token, and requires DEV_AUTH_BYPASS on the backend.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
